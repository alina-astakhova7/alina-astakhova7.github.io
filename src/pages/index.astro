---
import Layout from '../layouts/Layout.astro';
import Contacts from '../components/Contacts.astro';
import Pic from '../components/Pic.astro';
import { cases } from '../data/cases';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const arrow = `<svg class="card__arrow" viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M3.83 17.08a.33.33 0 0 0 .38.55L18.84 7.38l-1 5.71a.33.33 0 0 0 .65.12l1.15-6.5a.33.33 0 0 0-.27-.39l-6.5-1.14a.33.33 0 0 0-.11.66l5.71 1L3.83 17.09Z"/></svg>`;
---
<Layout title="Алина Астахова — UX/UI и продуктовый дизайнер" description="Портфолио Алины Астаховой: UX/UI и продуктовый дизайн, полный цикл от брифа и исследований до передачи макетов и ревью разработки.">
  <div class="wrap">
    <div class="top-avatar"><div class="avatar"><img src={`${base}/img/826b9712.webp`} alt="Алина Астахова" width="80" height="80" /></div></div>

    <header class="hero">
      <div class="hero__name">
        <h1 data-reveal="hero">Алина Астахова</h1>
        <span class="role" data-reveal="hero">UX/UI и продуктовый дизайнер</span>
      </div>
      <p class="hero__desc">Веду полный цикл дизайна: от брифа и исследований<br class="br-d" /> до передачи макетов и ревью разработки</p>
      <div class="hero__btns"><Contacts /></div>
    </header>

    <main>
      <section class="projects" aria-labelledby="projects">
        <h2 class="sec-title" id="projects" data-reveal>Проекты</h2>
        <div class="cards">
          {cases.map((c, n) => (
            <a class="card" href={`${base}/${c.slug}/`}>
              <div class="card__head">
                <p class="card__label">{c.label}</p>
                <div>
                  <div class="card__titlerow">
                    <h3 class="card__title">{c.title}</h3>
                    <Fragment set:html={arrow} />
                  </div>
                  <p class="tags">
                    {c.tags.map((t, i) => (
                      <>
                        {i > 0 && <span class={c.hide.includes(i) || (i === 1 && c.hide.includes(0)) ? 'm-hide' : ''} aria-hidden="true">/</span>}
                        <span class={c.hide.includes(i) ? 'm-hide' : ''}>{t}</span>
                      </>
                    ))}
                  </p>
                </div>
              </div>
              <Pic k={c.img} ar="css" eager={n === 0} />
            </a>
          ))}
        </div>
      </section>

      <section class="about" aria-labelledby="about">
        <h2 class="sec-title" id="about" data-reveal>Обо мне</h2>
        <div class="about__text">
          <p>Училась в Британке, в дизайне более 3-х лет, полностью владею Figma. Веду полный цикл дизайна: от брифа и исследований до передачи макетов и ревью разработки. Разрабатываю библиотеку компонентов. Знакома с продуктовыми исследованиями.</p>
          <p>Постоянно развиваю навыки в дизайне. В работе ценю логику, визуальный ритм, внимание к деталям. Инженерный бэкграунд помогает мне работать с технически сложными продуктами и разговаривать с разработчиками на одном языке.</p>
        </div>
      </section>

      <section class="contacts" aria-labelledby="contacts">
        <h2 class="sec-title" id="contacts" data-reveal>Контакты</h2>
        <div class="contacts__body">
          <div class="contacts__btns"><Contacts /></div>
          <p class="welcome">You’re welcome! :)</p>
        </div>
      </section>
    </main>
    <div class="main-end"></div>
  </div>
</Layout>
