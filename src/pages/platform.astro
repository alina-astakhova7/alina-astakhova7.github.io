---
import CaseLayout from '../layouts/CaseLayout.astro';
const steps = [
  { t: 'Мои расчёты', d: 'проекты, поиск, фильтр\nпо типу оборудования', x: 0, y: 0 },
  { t: 'Новый проект', d: 'номер заявки\nи тип оборудования', x: 408, y: 0 },
  { t: 'Сборка системы', d: 'блоки, параметры,\nпредварительный расчёт', x: 816, y: 0 },
  { t: 'Выбор решения', d: 'сравнение вариантов', x: 816, y: 152 },
  { t: 'Технический лист', d: 'блоки, графики, акустика,\nгабаритная схема', x: 408, y: 152 },
  { t: 'PDF для заказчика', d: 'скачивание листа\nрасчёта в PDF', x: 0, y: 152, end: true },
];
const pct = (v: number, of: number) => `${(v / of) * 100}%`;
---
<CaseLayout
  label="[ВЕЗА]"
  title="Внутренняя платформа проектирования и подбора оборудования [NDA]"
  tags={['Продукт с нуля', 'Информационная архитектура', 'B2B']}
  tagsHideMobile={[1]}
  description="Кейс под NDA: B2B-платформа для расчёта и подбора вентиляционного оборудования — информационная архитектура и флоу с нуля."
>
  <p>Внутренняя B2B-платформа, в которой инженеры и менеджеры производителя вентиляционного оборудования собирают систему из блоков, подбирают оборудование по расчёту и выпускают технический лист для заказчика. Готовых аналогов такого продукта на рынке нет.</p>

  <section class="sec">
    <div class="blk">
      <h2>Роль и инструменты</h2>
      <p>Моя роль: UX/UI дизайнер продукта. Спроектировала информационную архитектуру и пользовательские флоу с нуля, разработала интерфейсы и передала макеты в разработку. Работаю с инженерами-технологами, разработкой и стейкхолдерами. Продолжаю развивать платформу: добавляю новые типы оборудования и сценарии.<br />Инструменты: Figma, существующая библиотека компонентов компании.</p>
    </div>
  </section>

  <section class="sec">
    <div class="blk">
      <h2>О продукте</h2>
      <p>Платформа заменяет ручной подбор канального оборудования одним сценарием: от входящей заявки до готового технического листа в PDF. Инженер собирает приточно-вытяжную систему, задаёт параметры и сразу видит предварительный расчёт.</p>
      <p>Пользователи: инженеры и менеджеры производителя, которые готовят решения по заявкам проектных организаций и заказчиков. Аналогов с таким сценарием на рынке нет, поэтому структуру и логику экранов не с чем было сравнить: я проектировала их из рабочего процесса инженеров.</p>
    </div>
  </section>

  <section class="sec">
    <h2>Задачи</h2>
    <p>Спроектировать продукт, в котором расчёт и подбор оборудования идут одним понятным сценарием и заканчиваются документом для заказчика.</p>
    <ol>
      <li>Собрать структуру продукта с нуля: расчёты, проекты, системы, технические листы.</li>
      <li>Сделать сборку системы наглядной.</li>
      <li>Дать инженеру сравнить несколько вариантов решения и выбрать лучшее.</li>
      <li>Автоматически формировать технический лист для заказчика.</li>
      <li>Собрать интерфейс на существующей библиотеке компонентов, чтобы сократить сроки разработки.</li>
      <li>Заложить структуру, которую легко расширять новыми типами оборудования.</li>
    </ol>
  </section>

  <section class="sec">
    <div class="sec__head">
      <h2>Этапы работы</h2>
      <p class="sub">От разбора процесса до сопровождения разработки</p>
    </div>
    <ol>
      <li>Разобрала с инженерами, как сейчас идёт расчёт и подбор оборудования и что должно быть в итоговом документе.</li>
      <li>Спроектировала структуру продукта: расчёты → проект → системы → технические листы.</li>
      <li>Выстроила пользовательский флоу от входящей заявки до PDF для заказчика.</li>
      <li>Собрала интерфейс на существующей библиотеке компонентов: новые элементы делала только там, где их не было (палитра блоков, схема системы, графики).</li>
      <li>Проверила раскладки на брейкпоинтах 1200–2560 px.</li>
      <li>Передала макеты в разработку и сопровождаю внедрение. Дорабатываю платформу по мере её развития.</li>
    </ol>

    <div class="flow" role="img" aria-label="Флоу: Мои расчёты → Новый проект → Сборка системы → Выбор решения → Технический лист → PDF для заказчика">
      <svg viewBox="0 0 1152 240" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <marker id="ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M1 1 9 5 1 9" fill="none" stroke="rgba(232,235,233,.5)" stroke-width="1.4" />
          </marker>
        </defs>
        <g stroke="rgba(232,235,233,.5)" stroke-width="1.25" fill="none" vector-effect="non-scaling-stroke">
          <line x1="340" y1="44" x2="404" y2="44" marker-end="url(#ah)" vector-effect="non-scaling-stroke" />
          <line x1="748" y1="44" x2="812" y2="44" marker-end="url(#ah)" vector-effect="non-scaling-stroke" />
          <line x1="964" y1="92" x2="964" y2="148" marker-end="url(#ah)" vector-effect="non-scaling-stroke" />
          <line x1="1004" y1="148" x2="1004" y2="92" marker-end="url(#ah)" vector-effect="non-scaling-stroke" />
          <line x1="812" y1="196" x2="748" y2="196" marker-end="url(#ah)" vector-effect="non-scaling-stroke" />
          <line x1="404" y1="196" x2="340" y2="196" marker-end="url(#ah)" vector-effect="non-scaling-stroke" />
        </g>
      </svg>
      {steps.map((s) => (
        <div class={`flow__box ${s.end ? 'flow__box--end' : ''}`} style={`left:${pct(s.x, 1152)};top:${pct(s.y, 240)}`}>
          <b>{s.t}</b><span>{s.d.split('\n').map((l, i) => <>{i > 0 && <br />}{l}</>)}</span>
        </div>
      ))}
      <span class="flow__back">назад к расчёту</span>
    </div>
    <div class="flow-v" aria-hidden="true">
      {steps.map((s, i) => (
        <>
          {i > 0 && <svg class="down" viewBox="0 0 18 22"><path d="M9 1v19M3 14l6 6 6-6" fill="none" stroke="rgba(232,235,233,.5)" stroke-width="1.25" /></svg>}
          <div class={`flow__box ${s.end ? 'flow__box--end' : ''}`}><b>{s.t}</b><span>{s.d.replace('\n', ' ')}</span></div>
        </>
      ))}
    </div>
    <p class="dim">На каждом шаге можно вернуться назад: от выбора решения к расчёту, от технического листа к выбору решения.</p>
  </section>

  <section class="sec sec--plain">
    <div class="sec__head">
      <h2>Итог работы</h2>
      <p class="sub">Что сделано</p>
    </div>
    <p>Платформа объединила расчёт, подбор оборудования и выпуск технического листа в один сценарий. Раньше для этого не было инструмента ни в компании, ни на рынке.</p>
    <ol>
      <li>Спроектирована структура продукта и полный флоу: от заявки до PDF для заказчика.</li>
      <li>Интерфейс собран на существующей библиотеке компонентов → разработка идёт быстрее, дизайн консистентен с другими продуктами компании.</li>
      <li>Структура расширяется: платформа модернизируется, в неё добавляются новые типы оборудования и сценарии.</li>
    </ol>
  </section>
</CaseLayout>
